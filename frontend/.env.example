# API のベースURL（ブラウザから見えるURL。NEXT_PUBLIC_ はコードに埋め込まれるので秘密情報は置かない）
#   ローカル開発 : http://localhost:8080  （API 側で CORS を許可する）
#   本番         : /api                   （下の API_ORIGIN へ中継する。Cookie が同一オリジンで使える）
NEXT_PUBLIC_API_URL=http://localhost:8080

# /api/... の転送先（rewrites）。NEXT_PUBLIC_API_URL=/api のときに使う。ビルド時に固定される。
API_ORIGIN=http://localhost:8080
